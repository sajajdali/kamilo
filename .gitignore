# Laravel dependencies and generated assets
/vendor/
/node_modules/
/public/hot
/public/storage
/public/uploads/
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Runtime data
/storage/
/temp/
/*.log
/*.cache
/*.tmp
/*.pid

# Environment files and local credentials
.env
.env.*
!.env.example
/auth.json
/.phpunit.result.cache

# Server-specific files
.user.ini
public/.user.ini

# Local development environments
/.vagrant/
Homestead.json
Homestead.yaml

# Editors and IDEs
/.idea/
/.vscode/
/.fleet/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
._*
__MACOSX/
Thumbs.db
Desktop.ini

# Local archives, backups, and database dumps
/*.zip
/*.rar
/*.7z
/*.tar
/*.tar.gz
/*.tgz
/Modules/*.zip
/*.bak
/*.old
/*.orig
/*.sql
/*.sqlite
/*.sqlite3

# Package-manager error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Deployment-tool state
.git-ftp.log
