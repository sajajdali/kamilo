{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ghasedak/php": "^2.1",
        "guzzlehttp/guzzle": "^8.3",
        "intervention/image-laravel": "^4.1",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.10",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "maatwebsite/excel": "^4.0",
        "mpdf/mpdf": "^8.3",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-permission": "^8.3",
        "tormjens/eventy": "^0.9"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "doctrine/dbal": "^4.5",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/"
        },
        "exclude-from-classmap": [
            "/Modules/*/vendor/",
            "/Modules/*/Database/Migrations/",
            "/Modules/Appointment/Entities/*_old.php"
        ],
        "files": [
            "app/Helpers/jdf.php",
            "app/Helpers/queue.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
